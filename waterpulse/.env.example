# ---- Backend (never prefix secrets with VITE_) -------------------------------
# demo  = offline seeded workspace (DEMO DATA), no token needed locally
# pilot = zones anchored to the supplied public datasets; API_TOKEN (>=32 chars) required
APP_MODE=pilot
DATABASE_PATH=waterpulse.sqlite3
ALLOWED_ORIGINS=http://localhost:5173
API_TOKEN=
# Per-client requests per minute (process-local limiter). Raise only for load/e2e tests.
RATE_LIMIT_PER_MINUTE=180
# Optional override of the data directory (defaults to <repo>/data).
DATA_DIR=

# ---- AWS ---------------------------------------------------------------------
AWS_REGION=ap-south-1
# Prefer an IAM role or AWS profile over static credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMODB_TABLE=
EVIDENCE_BUCKET=
# Bedrock only EXPLAINS evidence; it never calculates, approves or executes.
BEDROCK_MODEL_ID=

# ---- Weather (contextual evidence only) --------------------------------------
WEATHER_PROVIDER=weatherapi
WEATHER_API_KEY=

# ---- Routing (Amazon Location Routes; stays on the backend) -------------------
AMAZON_LOCATION_KEY=
AMAZON_LOCATION_REGION=ap-south-1

# ---- Interface-only placeholders (no official endpoint contract configured) ---
IMD_API_KEY=
CGWB_API_KEY=

# ---- Local dev convenience (NOT bundled into the browser) ----------------------
# The Vite dev server adds this bearer token to proxied /api calls, so the pilot
# works without typing a token. Use the same value as API_TOKEN.
DEV_PROXY_API_TOKEN=

# Frontend public configuration belongs in frontend/.env.local, e.g.:
#   VITE_MAPTILER_KEY=...        (browser-visible by design; restrict it by domain in MapTiler)
#   VITE_API_BASE=http://localhost:8000/api
