# RAHAT AI environment. Copy to .env (git-ignored) and fill in YOUR rotated keys. Never commit real values.
# Backend reads these; nothing here is bundled into the browser.

# ---- Mode -------------------------------------------------------------
# real = use real providers where credentialed; any provider that fails falls back to labelled DEMO DATA
# demo = everything local, no credentials needed
PROVIDER_MODE=real
ENABLE_DEMO_FALLBACK=true

# ---- AWS --------------------------------------------------------------
AWS_REGION=ap-south-1
# Amazon Location API key (restrict it to Places + Routes actions and your allowed referrers in the AWS console)
AWS_LOCATION_API_KEY=
BEDROCK_MODEL_ID=
S3_BUCKET=
DYNAMODB_TABLE=

# ---- WeatherAPI (backend only) ---------------------------------------
WEATHERAPI_KEY=
WEATHERAPI_BASE_URL=https://api.weatherapi.com/v1

# ---- Public, keyless data sources ------------------------------------
OVERPASS_URL=https://overpass-api.de/api/interpreter
PLANETARY_COMPUTER_STAC_URL=https://planetarycomputer.microsoft.com/api/stac/v1
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# ---- Storage ----------------------------------------------------------
STORE_MODE=sqlite
DATABASE_PATH=rahat.db

# ---- Emergency SOS ----------------------------------------------------
# RAHAT_SOS_ENABLED=true # Requires AWS End User Messaging SMS configured
# RAHAT_SOS_CONTACT_NUMBER=+1234567890 # Pre-verified emergency contact
# AWS_REGION=ap-south-1 # Used for both DynamoDB (if STORE_MODE=dynamodb) and SMS
# RAHAT_SOS_VOICE_ORIGINATION=+1234567890 # Required for AWS Voice Calls
